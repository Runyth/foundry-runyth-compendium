{
  "build": {
    "exclude": [
      "**/*.map",
      "**/*.ts",
      "**/*.tsx",
      "**/.DS_Store",
      "**/Thumbs.db"
    ],
    "include": [
      "module.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "packs/**"
    ],
    "preBuild": [
      {
        "args": [
          "tools/module/build-packs.mjs",
          "--check"
        ],
        "command": "node"
      }
    ],
    "sourceExclude": [
      ".git/**",
      ".github/template-sync-token*",
      ".runyth-template-source/**",
      "dist/**",
      "node_modules/**",
      "coverage/**",
      ".nyc_output/**",
      ".cache/**",
      "*.log",
      ".env",
      ".env.*",
      "**/.DS_Store",
      "**/Thumbs.db"
    ]
  },
  "module": {
    "entryMode": "passthrough",
    "kind": "content",
    "publicApi": false,
    "repository": "Runyth/foundry-runyth-compendium",
    "systemNeutral": true
  },
  "runtimeKit": {
    "managed": false
  },
  "schemaVersion": 1,
  "template": {
    "repository": "Runyth/template-foundry-module",
    "source": false,
    "version": "1.1.0"
  },
  "validation": {
    "allowFindings": [],
    "forbidPrivateFoundryApis": true,
    "forbidSourceMaps": true,
    "requireLocaleParity": false,
    "requireRepositoryUrls": true,
    "requireVersionParity": true,
    "requiredLocales": []
  }
}
